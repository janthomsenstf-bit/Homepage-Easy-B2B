# Easy-B2B Homepage — Environment Variables
# Kopiere diese Datei nach .env.local und fülle die Werte aus.

# PostgreSQL Datenbank (Neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Resend E-Mail (resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@easyb2b.de"
# Für Tests ohne Domain-Verifizierung: "onboarding@resend.dev"

# Operator E-Mail (bekommt alle Benachrichtigungen)
OPERATOR_EMAIL="jan@easyb2b.de"

# NextAuth (falls Login verwendet wird)
NEXTAUTH_SECRET="generiere-mit-openssl-rand-hex-32"
NEXTAUTH_URL="https://homepage-easy-b2-b.vercel.app"
